make_valid_cor <- function(R, tol = 1e-10, force_pd = TRUE, quiet = FALSE) {
if (!is.matrix(R)) R <- as.matrix(R)
if (!is.numeric(R)) stop("R muss numerisch sein.")
if (anyNA(R)) stop("R enthält NA.")
if (nrow(R) != ncol(R)) stop("R muss quadratisch sein.")
# symmetrisieren + diag=1
asym <- max(abs(R - t(R)))
R <- (R + t(R)) / 2
diag_diff <- max(abs(diag(R) - 1))
diag(R) <- 1
if (any(R < -1 - 1e-8 | R > 1 + 1e-8)) {
stop("R enthält Werte außerhalb [-1, 1].")
}
ev <- eigen(R, symmetric = TRUE, only.values = TRUE)$values
min_ev <- min(ev)
repaired <- FALSE
method <- "none"
if (min_ev <= tol) {
if (!force_pd) stop(sprintf("R ist nicht positiv definit (min EV=%.3g).", min_ev))
repaired <- TRUE
if (requireNamespace("Matrix", quietly = TRUE)) {
npd <- Matrix::nearPD(R, corr = TRUE)
R <- as.matrix(npd$mat)   # <-- wichtig: base-matrix
method <- "Matrix::nearPD"
} else {
e <- eigen(R, symmetric = TRUE)
vals <- pmax(e$values, tol)
R <- e$vectors %*% diag(vals, nrow(R)) %*% t(e$vectors)
D <- diag(1 / sqrt(diag(R)))
R <- D %*% R %*% D
R <- (R + t(R)) / 2
diag(R) <- 1
method <- "eigen-fix"
}
}
ev2 <- eigen(R, symmetric = TRUE, only.values = TRUE)$values
list(
R = R,
report = list(
p = nrow(R),
asym_before = asym,
diag_max_abs_before = diag_diff,
min_eigen_before = min_ev,
min_eigen_after = min(ev2),
repaired = repaired,
method = method
)
)
}
