branchen <- c(
"Automobilindustrie", "Bauwirtschaft", "Energie und Rohstoffe",
"Familienunternehmen & Mittelstand", "Finanzbranche",
"Gesundheitswirtschaft", "Handel", "Industrielle Produktion",
"Infrastruktur", "International Business", "Kirchliche Organisationen",
"Konsumgüter", "Life Sciences & Chemie", "Öffentlicher Sektor",
"Private Equity", "Real Estate",
"Technologie, Medien & Telekommunikation", "Transport & Logistik"
)
dl_audit <- c(
"Integrierte Abschlussprüfung", "Regulatory Advisory",
"Digital Process Compliance", "Forensic",
"Sustainability Reporting & Governance", "Audit Technology",
"Capital Markets & Accounting Assurance"
)
dl_tax <- c(
"Corporate Tax Services", "Global Mobility Services",
"Global Transfer Pricing Services", "Indirect Tax Services",
"International Transaction Tax", "Public Sector Tax",
"Tax Transformation"
)
dl_advisory <- c(
"Consulting", "Deal Advisory", "Performance & Strategy"
)
set.seed(1978)
n <- nrow(scores)
# Branche: 18 Stufen, unabhängig von allem anderen
branche <- factor(
sample(rep(branchen, length.out = n)),
levels = branchen
)
# Servicebereich: 3 Stufen, ca. 333 je
servicebereich_raw <- sample(rep(c("Audit", "Tax", "Advisory"), length.out = n))
servicebereich <- factor(servicebereich_raw, levels = c("Audit", "Tax", "Advisory"))
# Dienstleistung: innerhalb jedes Servicebereichs gleichmäßig
idx_a <- which(servicebereich == "Audit")
idx_t <- which(servicebereich == "Tax")
idx_v <- which(servicebereich == "Advisory")
dl_vec <- character(n)
dl_vec[idx_a] <- sample(rep(dl_audit,    length.out = length(idx_a)))
dl_vec[idx_t] <- sample(rep(dl_tax,      length.out = length(idx_t)))
dl_vec[idx_v] <- sample(rep(dl_advisory, length.out = length(idx_v)))
dienstleistung <- factor(dl_vec, levels = c(dl_audit, dl_tax, dl_advisory))
# ---- An scores anfügen ----
scores$branche        <- branche
scores$servicebereich <- servicebereich
scores$dienstleistung <- dienstleistung
# ---- Checks ----
cat("Branche:\n");        print(table(branche))
cat("\nServicebereich:\n"); print(table(servicebereich))
cat("\nDienstleistung:\n"); print(table(dienstleistung))
# Unabhängigkeit branche ~ servicebereich (sollte p >> .05 sein)
cat("\nChisq branche x servicebereich:\n")
print(chisq.test(table(branche, servicebereich)))
