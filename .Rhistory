# Chunk 6
get_axis_weights <- function(fit, anchors) {
pe <- parameterEstimates(fit, standardized = TRUE)
# formative Gewichte: lhs = A?, op = "~", rhs = Prädiktor
betas <- subset(pe, op == "~" & lhs %in% names(anchors),
select = c("lhs","rhs","est"))
# Anchor bekommt Gewicht 1 (weil A =~ 1*anchor); du kannst alternativ est.std nehmen
anchor_df <- data.frame(
lhs = names(anchors),
rhs = unname(anchors),
est = 1
)
w <- rbind(anchor_df, betas)
# als Liste pro Achse
split(w[, c("rhs","est")], w$lhs)
}
anchors <- c(
A1="ext_warm", A2="ext_asrt", A3="emo_stab", A4="con_ordr", A5="emo_intl",
A6="rsk_prop", A7="cog_flex", A8="pol_skil", A9="pow_motv", A10="tru_prop"
)
score_axes <- function(dat, W, center = TRUE, scale = TRUE, to_1_6 = FALSE) {
# W: entweder
#  (a) Liste pro Achse: W$A1 ist data.frame(rhs, est)
#  (b) Matrix mit rownames = Variablennamen, colnames = Achsen
make_Z <- function(X, center, scale) {
Z <- X
if (isTRUE(center)) {
mu <- colMeans(Z, na.rm = TRUE)
Z <- sweep(Z, 2, mu, "-")
} else if (is.numeric(center)) {
Z <- sweep(Z, 2, center[colnames(Z)], "-")
}
if (isTRUE(scale)) {
sdv <- apply(Z, 2, sd, na.rm = TRUE)
sdv[sdv == 0 | is.na(sdv)] <- 1
Z <- sweep(Z, 2, sdv, "/")
} else if (is.numeric(scale)) {
sdv <- scale[colnames(Z)]
sdv[sdv == 0 | is.na(sdv)] <- 1
Z <- sweep(Z, 2, sdv, "/")
}
Z
}
if (is.matrix(W)) {
needed <- rownames(W)
X <- as.matrix(dat[, needed, drop = FALSE])
Z <- make_Z(X, center, scale)
scores <- Z %*% W
scores <- as.data.frame(scores)
} else if (is.list(W)) {
axes <- names(W)
needed <- sort(unique(unlist(lapply(W, `[[`, "rhs"))))
X <- as.matrix(dat[, needed, drop = FALSE])
Z <- make_Z(X, center, scale)
scores <- sapply(axes, function(ax) {
vars <- W[[ax]]$rhs
wts  <- W[[ax]]$est
drop(Z[, vars, drop = FALSE] %*% wts)
})
scores <- as.data.frame(scores)
} else {
stop("W muss entweder eine Matrix oder eine Liste pro Achse sein.")
}
if (to_1_6) scores <- as.data.frame(lapply(scores, function(x) 1 + 5*plogis(x)))
scores
}
